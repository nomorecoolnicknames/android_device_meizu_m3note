// Device-local fork of hardware/lineage/interfaces/biometrics/fingerprint/2.0
// for the Goodix GF516M module.
//
// Differences from upstream:
//   1. BiometricsFingerprint.h declares meizu_fingerprint_device_t, the real
//      272-byte layout with the four Goodix vendor methods, so authenticate,
//      cancel, remove, set_active_group and get_authenticator_id land on the
//      functions they name.
//   2. service.cpp starts a framework binder threadpool; the daemon's results
//      arrive on /dev/binder.
//   3. enumerate() does not call through the null slot.
//
// The module name carries a .m3note suffix only to avoid colliding with the
// upstream module; the service name (vendor.fps_hal) and the HIDL instance
// (default) are unchanged.
cc_binary {
    name: "android.hardware.biometrics.fingerprint@2.0-service.m3note",
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    init_rc: ["android.hardware.biometrics.fingerprint@2.0-service.m3note.rc"],
    srcs: [
        "service.cpp",
        "BiometricsFingerprint.cpp",
    ],
    shared_libs: [
        "libutils",
        "liblog",
        "libhidlbase",
        "libhardware",
        // Framework binder: the Goodix module and its daemon talk over
        // /dev/binder, and this process has to serve that node itself.
        "libbinder",
        "android.hardware.biometrics.fingerprint@2.1",
    ],
    proprietary: true,
}
