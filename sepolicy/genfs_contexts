# Pie base policy no longer labels /m4u.
genfscon proc /m4u u:object_r:mtk_m4u_proc:s0
genfscon proc /lk_env u:object_r:proc_lk_env:s0
genfscon sysfs /devices/platform/leds-mt65xx u:object_r:sysfs_leds:s0
genfscon sysfs /devices/virtual/misc/m_ u:object_r:sysfs_sensor:s0

# GT9XX touch gestures (power.m3note, tap to wake)
genfscon sysfs /devices/mx_tsp u:object_r:sysfs_tp_gesture:s0
