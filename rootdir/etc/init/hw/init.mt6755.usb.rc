# configfs USB gadget.
#
# system/core init.usb.configfs.rc only drives an existing g1 (writes UDC,
# links functions); creating g1, ffs.adb and the functionfs mount is the
# device's job.  The kernel has USB only through configfs; the UDC is the
# mu3d controller "musb-hdrc".
#
# VID/PID 2a45:201c, as enumerated by the stock firmware.
#
# init.usb.rc sets sys.usb.configfs 0 on init; it is overridden in `on boot`.
# The gadget is created on early-fs, so adb can come up even if mount_all
# fails.

on early-init
    # musb ffs AIO wedges bulk-IN; force the legacy r/w path.  adbd reads it
    # once in usb_ffs_init().
    setprop sys.usb.ffs.aio_compat 1

on early-fs
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/idVendor 0x2a45
    write /config/usb_gadget/g1/idProduct 0x201c
    mkdir /config/usb_gadget/g1/strings/0x409 0770
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer Meizu
    write /config/usb_gadget/g1/strings/0x409/product "M3 Note"
    mkdir /config/usb_gadget/g1/configs/b.1 0770
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    # init.usb.configfs.rc links mtp.gs0 and ptp.gs1 but never creates them;
    # without them "File transfer" with debugging off leaves config b.1 empty
    # and the UDC write fails.
    mkdir /config/usb_gadget/g1/functions/mtp.gs0
    mkdir /config/usb_gadget/g1/functions/ptp.gs1
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000

on boot
    setprop sys.usb.controller musb-hdrc
    setprop sys.usb.configfs 1
