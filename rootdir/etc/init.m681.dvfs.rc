# M681 CPU DVFS ceiling, mode and LL overclock.
#
# cpufreq arms ~150 s after boot under the boot ceiling LL 689 / big 1196 MHz.
# Only these properties lift it; the kernel nodes are module parameters, so
# they can be written before cpufreq arms and take effect when it does.
#
#   persist.vendor.m681.cpu_max   1196 (default) | stock (LL 1001 / big 1807)
#   persist.vendor.m681.cpu_mode  auto (default: interactive + touch boost) |
#                                 performance (min = max; thermal limits still apply)
#   persist.vendor.m681.ll_oc     0 (default) .. 5: highest LL overclock row,
#                                 1092/1144/1196/1404/1599 MHz at the stock 1.150 V;
#                                 read when cpufreq arms, so set it and reboot
#
# A hang or crash at the stock ceiling must not repeat on every boot: a boot
# that applies it marks persist.vendor.m681.cpu_trial=1, an orderly
# shutdown/reboot clears it. If the previous boot never cleared it, this boot
# drops cpu_max back to 1196 (cpu_max_fallback records why).

# snapshot of the last boot's mark, once the persist properties are loaded
on property:ro.persistent_properties.ready=true && property:ro.vendor.meizu.profile=m681
    setprop vendor.m681.cpu_prev_trial ${persist.vendor.m681.cpu_trial:-0}

on property:sys.boot_completed=1 && property:vendor.m681.cpu_prev_trial=1 && property:persist.vendor.m681.cpu_max=stock
    setprop persist.vendor.m681.cpu_max 1196
    setprop persist.vendor.m681.cpu_max_fallback unclean-shutdown-at-stock
    setprop persist.vendor.m681.cpu_trial 0
    setprop vendor.m681.cpu_prev_trial 0

on property:sys.boot_completed=1 && property:vendor.m681.cpu_prev_trial=0 && property:persist.vendor.m681.cpu_max=stock
    setprop persist.vendor.m681.cpu_trial 1
    write /sys/module/forge_therm_guard/parameters/forge_tg_ceiling_khz 0
    write /sys/module/mt_cpufreq/parameters/forge_ll_oc ${persist.vendor.m681.ll_oc:-0}
    write /sys/module/mt_cpufreq/parameters/forge_cpu_max_ll_khz 1599000
    write /sys/module/mt_cpufreq/parameters/forge_cpu_max_big_khz 1807000

on property:sys.boot_completed=1 && property:persist.vendor.m681.cpu_max=1196 && property:ro.vendor.meizu.profile=m681
    write /sys/module/mt_cpufreq/parameters/forge_cpu_max_ll_khz 689000
    write /sys/module/mt_cpufreq/parameters/forge_cpu_max_big_khz 1196000

on shutdown && property:ro.vendor.meizu.profile=m681
    setprop persist.vendor.m681.cpu_trial 0

on property:sys.boot_completed=1 && property:persist.vendor.m681.cpu_mode=performance && property:ro.vendor.meizu.profile=m681
    write /sys/module/mt_cpufreq/parameters/forge_cpu_perf 1

on property:sys.boot_completed=1 && property:persist.vendor.m681.cpu_mode=auto && property:ro.vendor.meizu.profile=m681
    write /sys/module/mt_cpufreq/parameters/forge_cpu_perf 0
