# SPDX-License-Identifier: Apache-2.0
#
# Recovery and OTA. Raw partition numbers: the same on M681 and L681, and the
# platform by-name path differs between the stock 3.10 recovery kernels and 4.9.
#
# <src>                <mnt_point>  <type>  <mnt_flags and options>  <fs_mgr_flags>
/dev/block/mmcblk0p1   /recovery    emmc    defaults                  defaults
/dev/block/mmcblk0p22  /boot        emmc    defaults                  defaults
/dev/block/mmcblk0p29  /system      ext4    ro,barrier=1              wait
/dev/block/mmcblk0p30  /cache       ext4    noatime,nosuid,nodev,noauto_da_alloc,discard  wait,check
/dev/block/mmcblk0p31  /data        ext4    noatime,nosuid,nodev,noauto_da_alloc,discard  wait,check
