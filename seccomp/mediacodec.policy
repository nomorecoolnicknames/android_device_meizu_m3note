# Additional mediacodec seccomp policy for the MTK OMX components.
#
# The vendor set ships no /vendor/etc/seccomp_policy/mediacodec.policy, so the
# MTK OMX plugins (libMtkOmx*Dec/Enc.so) hit SIGSYS under the base policy alone.
# media.omx is 32-bit ARM here, so the names are the 32-bit ARM (eabi) set;
# minijail skips names it cannot resolve. Entries are added to the base policy.

# MTK mediacodec policy (from the stock firmware)
futex: 1
ioctl: 1
write: 1
prctl: 1
clock_gettime: 1
getpriority: 1
read: 1
close: 1
writev: 1
dup: 1
ppoll: 1
mmap2: 1
munmap: 1
mprotect: 1
madvise: 1
openat: 1
sigaltstack: 1
clone: 1
setpriority: 1
getuid32: 1
fstat64: 1
pread64: 1
faccessat: 1
readlinkat: 1
exit: 1
rt_sigprocmask: 1
set_tid_address: 1
restart_syscall: 1
exit_group: 1
rt_sigreturn: 1
pipe2: 1
gettimeofday: 1
sched_yield: 1
nanosleep: 1
lseek: 1
sched_get_priority_max: 1
sched_get_priority_min: 1
statfs64: 1
sched_setscheduler: 1
fstatat64: 1
ugetrlimit: 1

# MTK video-extend plugins opendir(/system/lib/extend)
getdents64: 1

# for bsp and tk only
_llseek: 1
sched_getparam: 1
pselect6: 1
sched_getscheduler: 1
sched_setaffinity: 1
sendto: 1
recvfrom: 1

# for attaching to debuggerd on process crash
sigaction: 1
tgkill: 1
socket: 1
connect: 1
fcntl64: 1
rt_tgsigqueueinfo: 1
mlock: 1
munlock: 1
setsockopt: 1
setrlimit: 1

# Additional syscalls the MTK OMX components may reach on Pie.
gettid: 1
getpid: 1
tkill: 1
rt_sigtimedwait: 1
getrandom: 1
sched_getaffinity: 1
sysinfo: 1
mremap: 1
msync: 1
dup3: 1
epoll_create1: 1
epoll_ctl: 1
epoll_pwait: 1
eventfd2: 1
timerfd_create: 1
timerfd_settime: 1
ftruncate64: 1
pwrite64: 1
fsync: 1
fdatasync: 1
memfd_create: 1
prlimit64: 1
clock_getres: 1
getcpu: 1
process_vm_readv: 1
